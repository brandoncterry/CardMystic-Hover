{
  "manifest_version": 3,
  "name": "CardMystic Hover",
  "version": "0.1.0",
  "description": "Turns Magic: The Gathering card names on supported pages into CardMystic links with a hover preview.",
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "tabs",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "host_permissions": ["https://api.scryfall.com/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/sites/mtgwiki.js",
        "src/sites/reddit.js",
        "src/sites/moxfield.js",
        "src/sites/edhrec.js",
        "src/sites/index.js",
        "src/content/matcher.js",
        "src/content/plus.js",
        "src/content/history.js",
        "src/content/rewriter.js",
        "src/content/hover.js",
        "src/content/sitesettings.js",
        "src/content/fab.js",
        "src/content/content.js"
      ],
      "css": ["src/content/hover.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon-128.png",
        "assets/icon-48.png",
        "assets/icon-16.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "commands": {
    "open-clipboard-viewer": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "MacCtrl+Shift+Space"
      },
      "description": "Open the CardMystic clipboard viewer"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cardmystic-hover@cardmystic.com",
      "strict_min_version": "115.0"
    }
  }
}
